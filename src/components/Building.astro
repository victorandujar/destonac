---
/**
 * Sección técnica de un edificio, dibujada en SVG. Cada nivel es un <g data-level>
 * que el recorrido por plantas ilumina (clase .on). Conductos con aire animado y
 * ventiladores girando (se detienen con movimiento reducido).
 */
interface Props { class?: string; labels?: boolean; title: string }
const { class: cls = '', labels = true, title } = Astro.props;
const fan = (cx: number, cy: number, r: number) => ({ cx, cy, r });
const fans = [fan(167, 128, 11), fan(237, 128, 11), fan(311, 99, 7), fan(392, 416, 10)];
---
<svg viewBox="0 0 470 560" class:list={['building', cls]} role="img" aria-label={title} data-building fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
  <!-- Estructura base -->
  <g stroke-width="1.5" class="structure">
    <line x1="20" y1="530" x2="460" y2="530" />
    <rect x="100" y="144" width="280" height="8" />
    <line x1="110" y1="152" x2="110" y2="530" />
    <line x1="370" y1="152" x2="370" y2="530" />
    <rect x="110" y="330" width="260" height="6" />
    <!-- ventanas -->
    <path d="M370 230 h0 M366 220 v60 M366 410 v60" stroke-width="3" opacity="0.6" />
  </g>

  <!-- CUBIERTA: máquinas exteriores + grúa -->
  <g data-level="cubierta" class="lvl">
    <rect x="145" y="112" width="44" height="32" rx="2" stroke-width="1.5" />
    <rect x="215" y="112" width="44" height="32" rx="2" stroke-width="1.5" />
    <line x1="275" y1="144" x2="275" y2="168" stroke-width="1.2" stroke-dasharray="2 3" />
    <!-- grúa -->
    <g stroke-width="1.2">
      <line x1="430" y1="530" x2="430" y2="40" /><line x1="440" y1="530" x2="440" y2="40" />
      <path d="M430 520 L440 500 L430 480 L440 460 L430 440 L440 420 L430 400 L440 380 L430 360 L440 340 L430 320 L440 300 L430 280 L440 260 L430 240 L440 220 L430 200 L440 180 L430 160 L440 140 L430 120 L440 100 L430 80 L440 60 L430 40" opacity="0.6" />
      <line x1="440" y1="40" x2="285" y2="40" /><line x1="440" y1="50" x2="300" y2="40" />
      <line x1="311" y1="40" x2="311" y2="84" stroke-dasharray="3 3" />
      <rect x="295" y="84" width="32" height="22" rx="2" />
    </g>
  </g>

  <!-- FACHADA: unidad exterior con soporte + escalera -->
  <g data-level="fachada" class="lvl">
    <rect x="374" y="398" width="38" height="36" rx="2" stroke-width="1.5" />
    <path d="M374 434 L404 446 M374 446 L404 446" stroke-width="1.2" />
    <path d="M378 530 L398 300 M392 530 L412 300" stroke-width="1.2" />
    <path d="M381 495 L395 495 M384 460 L398 460 M387 425 L401 425 M390 390 L404 390 M393 355 L407 355 M396 320 L410 320" stroke-width="1" opacity="0.7" />
  </g>

  <!-- TECHO TÉCNICO: conductos sobre falsos techos -->
  <g data-level="techo" class="lvl">
    <line x1="110" y1="190" x2="370" y2="190" stroke-width="1" stroke-dasharray="5 4" />
    <rect x="130" y="160" width="200" height="18" rx="2" stroke-width="1.5" />
    <line x1="138" y1="169" x2="322" y2="169" stroke-width="2" class="flow" />
    <path d="M300 178 V190 M270 178 V190" stroke-width="1.5" />
    <rect x="190" y="188" width="44" height="7" rx="1" stroke-width="1.5" />
    <line x1="110" y1="364" x2="370" y2="364" stroke-width="1" stroke-dasharray="5 4" />
    <rect x="130" y="342" width="130" height="14" rx="2" stroke-width="1.5" />
    <line x1="138" y1="349" x2="252" y2="349" stroke-width="2" class="flow" />
  </g>

  <!-- OFICINAS Y LOCALES -->
  <g data-level="oficina" class="lvl" stroke-width="1.3">
    <path d="M140 288 h70 M146 288 v38 M204 288 v38" />
    <rect x="160" y="270" width="22" height="16" rx="1" />
    <path d="M230 288 h70 M236 288 v38 M294 288 v38" />
    <rect x="252" y="270" width="22" height="16" rx="1" />
    <path d="M170 300 q0 -14 12 -14 M182 326 v-26 M174 326 h16" opacity="0.8" />
    <path d="M262 300 q0 -14 12 -14 M274 326 v-26 M266 326 h16" opacity="0.8" />
    <path d="M200 205 l-6 22 M224 205 l6 22" stroke-dasharray="2 4" opacity="0.7" />
  </g>

  <!-- VIVIENDAS -->
  <g data-level="vivienda" class="lvl" stroke-width="1.3">
    <rect x="300" y="384" width="60" height="16" rx="4" />
    <path d="M306 404 q24 10 48 0" stroke-dasharray="2 4" opacity="0.7" />
    <path d="M140 500 v-26 q0 -8 8 -8 h84 q8 0 8 8 v26 M136 500 h108 M140 484 h100" />
    <path d="M270 530 v-40 M262 490 h16 l-4 -14 h-8 z" />
  </g>

  <!-- MANTENIMIENTO: revisiones de equipos -->
  <g data-level="mantenimiento" class="lvl" stroke-width="1" stroke-dasharray="3 4">
    <circle cx="167" cy="128" r="30" />
    <circle cx="237" cy="128" r="30" />
    <circle cx="393" cy="416" r="30" />
  </g>

  <!-- Ventiladores (giran) -->
  <g stroke-width="1.2">
    {fans.map((f) => (
      <g class="fan"><circle cx={f.cx} cy={f.cy} r={f.r} /><path d={`M${f.cx - f.r * 0.8} ${f.cy} H${f.cx + f.r * 0.8} M${f.cx} ${f.cy - f.r * 0.8} V${f.cy + f.r * 0.8}`} /></g>
    ))}
  </g>

  {labels && (
    <g class="labels" stroke="none" fill="currentColor" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="0.8">
      <text x="20" y="132" data-label="cubierta">CUBIERTA</text>
      <text x="20" y="176" data-label="techo">TECHO TÉC.</text>
      <text x="20" y="300" data-label="oficina">OFICINA</text>
      <text x="20" y="470" data-label="vivienda">VIVIENDA</text>
      <text x="412" y="470" data-label="fachada" text-anchor="end" transform="rotate(-90 452 470)">FACHADA</text>
    </g>
  )}
</svg>

<style>
  .building .lvl, .building .labels text { transition: opacity 450ms, color 450ms, filter 450ms; }
  .building[data-has-active] .lvl, .building[data-has-active] .labels text { opacity: 0.22; }
  .building[data-has-active] .lvl.on, .building[data-has-active] .labels text.on {
    opacity: 1;
    color: var(--color-cielo);
    filter: drop-shadow(0 0 6px rgb(88 184 216 / 0.6));
  }
</style>
