---
import Logo from './Logo.astro';
import { business, telUrl } from '../data/business';
const links = [
  { href: '#recorrido', label: 'Planta a planta' },
  { href: '#especialidades', label: 'Especialidades' },
  { href: '#mantenimiento', label: 'Mantenimiento' },
  { href: '#contacto', label: 'Contacto' },
];
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-noche/90 text-white backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-6 px-4 sm:px-8">
    <a href="/" class="flex items-center text-white" style="--logo-sky: var(--color-cielo)">
      <Logo class="h-8 sm:h-9" />
      <span class="sr-only">Destonac, inicio</span>
    </a>
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.95rem] text-white/80">
        {links.map((l) => <li><a href={l.href} class="py-2 hover:text-white">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-4">
      <a href={telUrl} class="mono hidden text-white/90 md:inline">{business.phone.display}</a>
      <a href="#contacto" class="btn btn-cielo min-h-10 py-2">Presupuesto</a>
    </div>
  </div>
</header>
