---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; heading: string }
const { title, description, heading } = Astro.props;
---
<Base title={title} description={description}>
  <Header />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8">
    <h1 class="titular text-[clamp(2.25rem,6vw,3.75rem)]">{heading}</h1>
    <div class="mt-10 space-y-5 text-lg leading-relaxed [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_mark]:bg-oro/25 [&_mark]:px-1"><slot /></div>
  </main>
  <Footer />
</Base>
